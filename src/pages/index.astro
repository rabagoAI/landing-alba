                <option value="eso">ESO</option>
                <option value="otro">Otro</option>
              </select>
            </div>
            <div>
              <label class="form-label" for="mensaje">Mensaje</label>
              <textarea
                id="mensaje"
                name="mensaje"
                rows="4"
                class="form-input resize-none"
                placeholder="Cuéntame qué necesitas: asignatura, nivel, disponibilidad..."
                required></textarea>
            </div>
            <button
              type="submit"
              id="submit-btn"
              class="btn-primary w-full justify-center py-3 text-sm"
            >
              <span id="btn-text">Enviar mensaje</span>
              <span id="btn-loading" class="hidden">Enviando...</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

