---
import Layout from "../layouts/Layout.astro";
import GlowCard from "../components/ui/GlowCard.astro";
import { BackgroundGradientAnimation } from "../components/ui/background-gradient-animation";
import GradientMenu from "../components/ui/gradient-menu";
---

<Layout>
  <!-- Background Shader -->
  <div class="fixed inset-0 w-full h-full -z-10 pointer-events-none">
    <BackgroundGradientAnimation client:load />
  </div>

  <!-- ===== NAVBAR ===== -->
  <nav
    id="navbar"
    class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
  >
    <div class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="#inicio" class="text-base font-bold text-white"
        >Alba Corregidor</a
      >

      <!-- Desktop links -->
      <div class="hidden md:flex items-center">
        <GradientMenu client:load />
      </div>

      <!-- Mobile hamburger -->
      <button
        id="menu-btn"
        class="md:hidden p-2 rounded-lg hover:bg-gray-100"
        aria-label="Menú"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>

    <!-- Mobile menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden bg-transparent border-t border-gray-100 px-6 py-4 flex flex-col gap-4"
    >
      <a
        href="#sobre-mi"
        class="text-sm font-medium text-gray-200 hover:text-blue-600"
        >Sobre mí</a
      >
      <a
        href="#servicios"
        class="text-sm font-medium text-gray-200 hover:text-blue-600"
        >Servicios</a
      >
      <a
        href="#contacto"
        class="text-sm font-medium text-gray-200 hover:text-blue-600"
        >Contacto</a
      >
      <a href="#contacto" class="btn-primary text-sm text-center"
        >Solicitar clase</a
      >
    </div>
  </nav>

  <!-- ===== HERO ===== -->
  <section id="inicio" class="hero-section pt-24">
    <div class="max-w-6xl mx-auto px-6">
      <!-- Top tag -->
      <div class="hero-tag mb-2">
        <span class="tag-top">🎓 Clases particulares</span>
      </div>

      <div class="grid md:grid-cols-2 gap-12 items-center">
        <!-- Left: text -->
        <div>
          <h1
            class="hero-title text-4xl md:text-5xl font-extrabold text-white leading-tight mb-4"
          >
            Aprende con<br />
            <span class="text-blue-600">Alba Corregidor</span>,<br />
            tu profesora de confianza
          </h1>
          <p class="hero-subtitle text-gray-300 text-base leading-relaxed mb-6">
            Licenciada en Magisterio con vocación por la enseñanza. Clases
            personalizadas para alumnos de Primaria y ESO. Mejora tus notas y
            recupera la confianza en ti mismo.
          </p>

          <!-- Trust badges -->
          <div class="hero-badges flex flex-wrap gap-3 mb-8">
            <span class="badge-blue">✅ Licenciada en Magisterio</span>
            <span class="badge-blue">🎯 5+ años de experiencia</span>
            <span class="badge-blue">📍 Presencial u online</span>
          </div>

          <div class="hero-buttons flex flex-wrap gap-3">
            <a href="#contacto" class="btn-primary">✉️ Contáctame</a>
            <a href="#servicios" class="btn-outline">Ver servicios →</a>
          </div>
        </div>

        <!-- Right: photo card -->
        <div class="hero-image">
          <div class="hero-photo-wrap">
            <!-- Teacher Photo -->
            <div class="flex flex-col items-center justify-center text-center">
              <div
                class="w-full max-w-sm mb-6 rounded-2xl overflow-hidden shadow-2xl hover:-translate-y-1 transition-transform duration-300 ring-4 ring-white/10"
              >
                <img
                  src="https://res.cloudinary.com/ds7shn66t/image/upload/v1775937957/A_professional_studio_202604112153_vdx1jl.jpg"
                  alt="Alba Corregidor"
                  class="w-full h-auto object-cover"
                />
              </div>
              <p class="text-white font-semibold text-xl">Alba Corregidor</p>
              <p class="text-blue-300 font-medium text-md">
                Profesora Particular
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== STATS BAR ===== -->
  <div class="stats-bar">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid grid-cols-2 md:grid-cols-4 divide-x divide-gray-200">
        <div class="stat-item reveal">
          <div class="stat-number">500+</div>
          <div class="stat-label">Alumnos ayudados</div>
        </div>
        <div class="stat-item reveal reveal-delay-1">
          <div class="stat-number">100%</div>
          <div class="stat-label">Tasa de aprobados</div>
        </div>
        <div class="stat-item reveal reveal-delay-2">
          <div class="stat-number">5k+</div>
          <div class="stat-label">Horas impartidas</div>
        </div>
        <div class="stat-item reveal reveal-delay-3">
          <div class="stat-number">15+</div>
          <div class="stat-label">Asignaturas</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Separador animado -->
  <div class="section-divider"></div>

  <!-- ===== SOBRE MÍ ===== -->
  <section id="sobre-mi" class="py-24 px-6 bg-transparent">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
      <!-- Illustration -->
      <div class="reveal">
        <div class="about-illustration">
          <img
            src="https://res.cloudinary.com/ds7shn66t/image/upload/v1775937957/A_clean__professional_202604112152_j2vbzo.jpg"
            alt="Ilustración de piezas de puzle"
            class="about-img"
          />
        </div>
      </div>

      <!-- Text -->
      <div class="reveal reveal-delay-2">
        <span class="tag-top">Sobre mí</span>
        <h2 class="section-title mt-2 mb-4">
          Dedicada a despertar el amor por aprender en cada alumno
        </h2>
        <p class="text-gray-300 text-sm leading-relaxed mb-4">
          Creo que cada alumno aprende de manera diferente. Mi enfoque está
          adaptado a las necesidades individuales, construyendo una base sólida
          y fomentando una curiosidad genuina por el conocimiento.
        </p>
        <p class="text-gray-300 text-sm leading-relaxed mb-6">
          Con más de 5 años de experiencia tanto en aulas como en clases
          particulares, he desarrollado estrategias que ayudan a los alumnos no
          solo a mejorar sus notas, sino también a superar la ansiedad ante los
          exámenes.
        </p>
        <div class="flex flex-wrap gap-3">
          <span class="badge-blue">🌱 Mentalidad de crecimiento</span>
          <span class="badge-blue">♾️ Para todos los estilos</span>
          <span class="badge-blue">💬 Comunicación con familias</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Separador animado -->
  <div class="section-divider"></div>

  <!-- ===== SERVICIOS ===== -->
  <section id="servicios" class="py-24 px-6 bg-transparent">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12 reveal">
        <h2 class="section-title">Cómo puedo ayudarte</h2>
        <p class="section-sub mt-2">
          Elige el formato que mejor se adapte a tu horario y preferencias.
        </p>
      </div>

      <!-- data-stagger dispara stagger automático en Layout.astro -->
      <div class="grid md:grid-cols-3 gap-6" data-stagger="true">
        <!-- Card 1 -->
        <div class="service-card">
          <div class="card-icon" style="background:#eff6ff;">📚</div>
          <h3>Clases Particulares</h3>
          <p>
            Sesiones individuales 1 a 1 completamente adaptadas al nivel y ritmo
            de cada alumno. Trabajamos juntos para reforzar los puntos débiles.
          </p>
          <ul>
            <li>Horario flexible</li>
            <li>Presencial u online</li>
            <li>Materiales incluidos</li>
          </ul>
          <a href="#contacto" class="learn-more">Solicitar info →</a>
        </div>

        <!-- Card 2 (popular) -->
        <div class="service-card" style="border-color: #1a56db;">
          <span class="popular-badge">Más popular</span>
          <div class="card-icon" style="background:#eff6ff;">🎓</div>
          <h3>Apoyo Escolar</h3>
          <p>
            Refuerzo continuo de las materias del colegio o instituto. Ayudo con
            los deberes, explico los conceptos del aula y preparo para
            controles.
          </p>
          <ul>
            <li>Todas las asignaturas</li>
            <li>Seguimiento semanal</li>
            <li>Informes a las familias</li>
          </ul>
          <a href="#contacto" class="learn-more">Solicitar info →</a>
        </div>

        <!-- Card 3 -->
        <div class="service-card">
          <div class="card-icon" style="background:#eff6ff;">📝</div>
          <h3>Preparación de Exámenes</h3>
          <p>
            Preparación intensiva para exámenes, selectividad o pruebas de
            acceso. Técnicas de estudio, simulacros y estrategias para rendir al
            máximo.
          </p>
          <ul>
            <li>Técnicas de estudio</li>
            <li>Simulacros de examen</li>
            <li>Gestión del estrés</li>
          </ul>
          <a href="#contacto" class="learn-more">Solicitar info →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Separador animado -->
  <div class="section-divider"></div>

  <!-- ===== METODOLOGÍA ===== -->
  <section id="metodologia" class="py-24 px-6 bg-transparent">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12 reveal">
        <h2 class="section-title">Cómo trabajo con cada alumno</h2>
        <p class="section-sub mt-2">
          Un proceso claro y efectivo para obtener resultados reales y
          duraderos.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="reveal space-y-0">
          <div class="method-row">
            <div class="method-num">1</div>
            <div>
              <h3 class="font-bold text-white mb-1">
                Diagnóstico inicial gratuito
              </h3>
              <p class="text-sm text-gray-300 leading-relaxed">
                Primera sesión para conocer al alumno, evaluar su nivel e
                identificar sus puntos débiles y objetivos.
              </p>
            </div>
          </div>
          <div class="method-row">
            <div class="method-num">2</div>
            <div>
              <h3 class="font-bold text-white mb-1">
                Plan de trabajo personalizado
              </h3>
              <p class="text-sm text-gray-300 leading-relaxed">
                Diseño un plan adaptado: objetivos claros, materiales
                específicos y calendario realista.
              </p>
            </div>
          </div>
          <div class="method-row">
            <div class="method-num">3</div>
            <div>
              <h3 class="font-bold text-white mb-1">
                Clases dinámicas y participativas
              </h3>
              <p class="text-sm text-gray-300 leading-relaxed">
                Sesiones activas donde el alumno es protagonista, con recursos
                visuales y aprendizaje activo.
              </p>
            </div>
          </div>
          <div class="method-row">
            <div class="method-num">4</div>
            <div>
              <h3 class="font-bold text-white mb-1">
                Seguimiento y comunicación continua
              </h3>
              <p class="text-sm text-gray-300 leading-relaxed">
                Evaluación constante del progreso y comunicación regular con las
                familias para mantenerlas informadas.
              </p>
            </div>
          </div>
        </div>

        <div class="reveal reveal-delay-2 flex justify-center">
          <div
            class="about-illustration w-full max-w-sm rounded-2xl overflow-hidden shadow-2xl"
          >
            <img
              src="https://res.cloudinary.com/ds7shn66t/image/upload/v1775937957/A_professional__warm_202604112203_vae2ct.jpg"
              alt="Ilustración de libro de texto"
              class="w-full h-auto object-cover"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== TESTIMONIOS ===== -->
  <section id="testimonios" class="py-24 px-6 bg-transparent">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12 reveal">
        <h2 class="section-title">Lo que dicen las familias</h2>
        <p class="section-sub mt-2">
          Experiencias reales de alumnos y familias que han confiado en Alba.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8" data-stagger="true">
        <!-- T1 -->
        <GlowCard glowColor="blue" class="testimonial-glow-card">
          <div class="flex flex-col h-full p-2">
            <div class="flex gap-1 mb-3">
              <span class="text-yellow-400 text-lg">★★★★★</span>
            </div>
            <p class="text-sm text-gray-200 leading-relaxed mb-5 italic flex-1">
              "Alba tiene un don especial para conectar con los niños. Mi hijo
              pasó de odiar las matemáticas a pedir más clases. En tres meses
              subió dos puntos su nota media."
            </p>
            <div class="flex items-center gap-3 mt-auto">
              <div
                class="w-10 h-10 rounded-full bg-blue-500/20 border border-blue-400/30 flex items-center justify-center text-lg"
              >
                👩
              </div>
              <div>
                <p class="font-bold text-sm text-white">María García</p>
                <p class="text-xs text-gray-400">Madre de alumno de 3º ESO</p>
              </div>
            </div>
          </div>
        </GlowCard>

        <!-- T2 -->
        <GlowCard glowColor="purple" class="testimonial-glow-card">
          <div class="flex flex-col h-full p-2">
            <div class="flex gap-1 mb-3">
              <span class="text-yellow-400 text-lg">★★★★★</span>
            </div>
            <p class="text-sm text-gray-200 leading-relaxed mb-5 italic flex-1">
              "Gracias a Alba aprobé biología con una nota que nunca imaginé. Su
              método de estudio y los simulacros me dieron la confianza que
              necesitaba."
            </p>
            <div class="flex items-center gap-3 mt-auto">
              <div
                class="w-10 h-10 rounded-full bg-purple-500/20 border border-purple-400/30 flex items-center justify-center text-lg"
              >
                👨
              </div>
              <div>
                <p class="font-bold text-sm text-white">Carlos López</p>
                <p class="text-xs text-gray-400">Alumno de 1º de la ESO</p>
              </div>
            </div>
          </div>
        </GlowCard>

        <!-- T3 -->
        <GlowCard glowColor="green" class="testimonial-glow-card">
          <div class="flex flex-col h-full p-2">
            <div class="flex gap-1 mb-3">
              <span class="text-yellow-400 text-lg">★★★★★</span>
            </div>
            <p class="text-sm text-gray-200 leading-relaxed mb-5 italic flex-1">
              "Lo que más valoro es su comunicación con los padres. Siempre nos
              mantiene informados del progreso de nuestra hija y nos da pautas
              para ayudarla en casa."
            </p>
            <div class="flex items-center gap-3 mt-auto">
              <div
                class="w-10 h-10 rounded-full bg-green-500/20 border border-green-400/30 flex items-center justify-center text-lg"
              >
                👩
              </div>
              <div>
                <p class="font-bold text-sm text-white">Ana Martínez</p>
                <p class="text-xs text-gray-400">
                  Madre de alumna de 5º Primaria
                </p>
              </div>
            </div>
          </div>
        </GlowCard>
      </div>
    </div>
  </section>

  <!-- ===== CONTACTO ===== -->
  <section id="contacto" class="contact-section py-24 px-6">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-12 items-start">
      <!-- Left: info -->
      <div class="reveal">
        <span
          class="tag-top"
          style="background:rgba(255,255,255,0.15); color:#93c5fd;"
          >Contacto</span
        >
        <h2 class="text-3xl font-extrabold text-white mt-3 mb-3">
          ¿Empezamos tu camino de aprendizaje?
        </h2>
        <p class="text-gray-400 text-sm leading-relaxed mb-8">
          Estoy aquí para responder cualquier pregunta sobre mi metodología,
          disponibilidad o precios. ¡Hablemos!
        </p>

        <div class="space-y-3">
          <!-- WhatsApp -->
          <a
            href="https://wa.me/34600000000?text=Hola%20Alba%2C%20me%20gustaría%20información%20sobre%20tus%20clases"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-info-item"
          >
            <div class="contact-icon-wrap" style="background:#25D366;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                <path
                  d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-sm text-white">WhatsApp</p>
              <p class="text-xs text-gray-400">+34 697 620 832</p>
            </div>
          </a>

          <!-- Email -->
          <a href="mailto:alba@albacorregidor.com" class="contact-info-item">
            <div class="contact-icon-wrap" style="background:#1a56db;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                <path
                  d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-sm text-white">Email</p>
              <p class="text-xs text-gray-400">alba@albacorregidor.com</p>
            </div>
          </a>

          <!-- Instagram -->
          <a
            href="https://instagram.com/albacorregidor"
            target="_blank"
            rel="noopener noreferrer"
            class="contact-info-item"
          >
            <div
              class="contact-icon-wrap"
              style="background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);"
            >
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                <path
                  d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-sm text-white">Instagram</p>
              <p class="text-xs text-gray-400">@albacorregidor</p>
            </div>
          </a>

          <!-- Location -->
          <div class="contact-info-item" style="cursor:default;">
            <div class="contact-icon-wrap" style="background:#374151;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="white">
                <path
                  d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-sm text-white">Ubicación</p>
              <p class="text-xs text-gray-400">Presencial u online</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right: form card -->
      <div class="reveal reveal-delay-2">
        <div class="form-card">
          <h3 class="font-bold text-white text-lg mb-5">Envíame un mensaje</h3>
          <form id="contact-form" class="space-y-4">
